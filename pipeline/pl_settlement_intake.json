{
	"name": "pl_settlement_intake",
	"properties": {
		"activities": [
			{
				"name": "until_wait_manifest",
				"type": "Until",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@variables('manifestfound')",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "GM_CHK_MANIFEST",
							"type": "GetMetadata",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "DS_ADLS_FILE_BIN",
									"type": "DatasetReference",
									"parameters": {
										"folderPath": {
											"value": "@concat('landing/',formatDateTime(pipeline().parameters.runDate,'yyyy/MM/dd'))",
											"type": "Expression"
										},
										"fileName": {
											"value": "@concat('_MANIFEST_',formatDateTime(pipeline().parameters.runDate,'yyyyMMdd'),'.ctl')",
											"type": "Expression"
										}
									}
								},
								"fieldList": [
									"exists"
								],
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "BinaryReadSettings"
								}
							}
						},
						{
							"name": "SV_MANIFEST_FOUND",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "GM_CHK_MANIFEST",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "manifestfound",
								"value": {
									"value": "@activity('GM_CHK_MANIFEST').output.exists",
									"type": "Expression"
								}
							}
						},
						{
							"name": "wait30sec",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "SV_MANIFEST_FOUND",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": {
									"value": "@if(variables('manifestfound'),1,30)",
									"type": "Expression"
								}
							}
						}
					],
					"timeout": "0.12:00:00"
				}
			},
			{
				"name": "GM_LISTFILES",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "until_wait_manifest",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_ADLS_FOLDER",
						"type": "DatasetReference",
						"parameters": {
							"folderPath": {
								"value": "@concat('landing/',formatDateTime(pipeline().parameters.runDate,'yyyy/MM/dd'))",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "fail_no_partnerfiles",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "until_wait_manifest",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "@concat('partner files not recieved for', pipeline().parameters.runDate)",
						"type": "Expression"
					},
					"errorCode": "NO_MANIFEST"
				}
			},
			{
				"name": "filter_csvfiles",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "GM_LISTFILES",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('GM_LISTFILES').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@endswith(item().name,'.csv' )",
						"type": "Expression"
					}
				}
			},
			{
				"name": "FE_FILES",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "filter_csvfiles",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('filter_csvfiles').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "EXEC_ProcessFile",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_set_intake_nested",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"folderPath": {
										"value": "@concat('landing/',formatDateTime(pipeline().parameters.runDate,'yyyy/MM/dd'))",
										"type": "Expression"
									},
									"fileName": {
										"value": "@item().name\r\n",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "AV_PROCESSED_FILES",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "EXEC_ProcessFile",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "processedfiles",
								"value": {
									"value": "@item().name",
									"type": "Expression"
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"runDate": {
				"type": "string",
				"defaultValue": "2026-10-11"
			}
		},
		"variables": {
			"manifestfound": {
				"type": "Boolean"
			},
			"processedfiles": {
				"type": "Array"
			},
			"runsummary": {
				"type": "String"
			}
		},
		"annotations": []
	}
}