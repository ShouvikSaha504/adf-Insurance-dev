{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-insurancess-dev"
		},
		"ls_az_dl_target_storage_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://ssinsurancedev.dfs.core.windows.net/"
		},
		"ls_az_storage_kv_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://az-insurance-kv.vault.azure.net/"
		},
		"pg_sql_src_ingest_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"pg_sql_src_ingest_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "postgres"
		},
		"pg_sql_src_ingest_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "postgres"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_insurance_claims_cdc')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "lkp_old_watermark",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "PostgreSqlV2Source",
								"query": "SELECT watermark_value from insurance_oltp.watermark_table LIMIT 1;",
								"queryTimeout": "02:00:00"
							},
							"dataset": {
								"referenceName": "watermark_tbl",
								"type": "DatasetReference",
								"parameters": {}
							}
						}
					},
					{
						"name": "lkp_new_watermark",
						"type": "Lookup",
						"dependsOn": [
							{
								"activity": "lkp_old_watermark",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "PostgreSqlV2Source",
								"query": "select max(updated_at) as new_watermark from insurance_oltp.claims;",
								"queryTimeout": "02:00:00"
							},
							"dataset": {
								"referenceName": "watermark_tbl",
								"type": "DatasetReference",
								"parameters": {}
							}
						}
					},
					{
						"name": "if_cdc",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "lkp_new_watermark",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@greater(ticks(activity('lkp_new_watermark').output.firstRow.new_watermark), ticks(activity('lkp_old_watermark').output.firstRow.watermark_value))",
								"type": "Expression"
							},
							"ifFalseActivities": [
								{
									"name": "lkp_log_nochanges",
									"type": "Lookup",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "PostgreSqlV2Source",
											"query": {
												"value": "INSERT INTO insurance_oltp.pipeline_run_log (pipeline_name, run_id, table_name, old_watermark, new_watermark, rows_copied, status) VALUES ('@{pipeline().Pipeline}', '@{pipeline().RunId}', 'claims', '@{activity('lkp_old_watermark').output.firstRow.watermark_value}', '@{activity('lkp_new_watermark').output.firstRow.new_watermark}', 0, 'NO_CHANGES')\n RETURNING log_id;",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00"
										},
										"dataset": {
											"referenceName": "watermark_tbl",
											"type": "DatasetReference",
											"parameters": {}
										}
									}
								}
							],
							"ifTrueActivities": [
								{
									"name": "cp_claims_cdc",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "PostgreSqlV2Source",
											"query": {
												"value": "select * from insurance_oltp.claims\n\nwhere updated_at > '@{activity('lkp_old_watermark').output.firstRow.watermark_value}'\n\nand updated_at <= '@{activity('lkp_new_watermark').output.firstRow.new_watermark}';\n",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00"
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings",
												"copyBehavior": "PreserveHierarchy"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "onprem_src_pgsql",
											"type": "DatasetReference",
											"parameters": {
												"table_name": "claims"
											}
										}
									],
									"outputs": [
										{
											"referenceName": "dest_parq_dataset",
											"type": "DatasetReference",
											"parameters": {
												"tableName": {
													"value": "@concat('claims_incremental/load_',formatDateTime(utcNow(),'yyyyMMddHHmmss'))",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "lkp_update_watermark",
									"type": "Lookup",
									"dependsOn": [
										{
											"activity": "cp_claims_cdc",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "PostgreSqlV2Source",
											"query": {
												"value": "UPDATE insurance_oltp.watermark_table \nSET watermark_value = '@{activity('lkp_new_watermark').output.firstRow.new_watermark}' \nWHERE table_name LIKE '%claims%'\nRETURNING watermark_value;",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00"
										},
										"dataset": {
											"referenceName": "watermark_tbl",
											"type": "DatasetReference",
											"parameters": {}
										}
									}
								},
								{
									"name": "lkp_log_run",
									"type": "Lookup",
									"dependsOn": [
										{
											"activity": "lkp_update_watermark",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "PostgreSqlV2Source",
											"query": {
												"value": "INSERT INTO insurance_oltp.pipeline_run_log (pipeline_name, run_id, table_name, old_watermark, new_watermark, rows_copied, status) VALUES ('@{pipeline().Pipeline}', '@{pipeline().RunId}', 'claims', '@{activity('lkp_old_watermark').output.firstRow.watermark_value}', '@{activity('lkp_new_watermark').output.firstRow.new_watermark}', @{activity('cp_claims_cdc').output.rowsCopied}, 'SUCCESS')\nRETURNING log_id;",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00"
										},
										"dataset": {
											"referenceName": "watermark_tbl",
											"type": "DatasetReference",
											"parameters": {}
										}
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/watermark_tbl')]",
				"[concat(variables('factoryId'), '/datasets/onprem_src_pgsql')]",
				"[concat(variables('factoryId'), '/datasets/dest_parq_dataset')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/dest_parq_dataset')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_az_dl_target_storage",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"tableName": {
						"type": "string"
					}
				},
				"folder": {
					"name": "insurance_datasets"
				},
				"annotations": [],
				"type": "Parquet",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().tableName",
							"type": "Expression"
						},
						"folderPath": "bronze_test_v2",
						"fileSystem": "destazinsurancedev"
					},
					"compressionCodec": "snappy"
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_az_dl_target_storage')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/onprem_src_pgsql')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "pg_sql_src_ingest",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"table_name": {
						"type": "string"
					}
				},
				"folder": {
					"name": "insurance_datasets"
				},
				"annotations": [],
				"type": "PostgreSqlV2Table",
				"schema": [],
				"typeProperties": {
					"schema": "insurance_oltp",
					"table": {
						"value": "@dataset().table_name",
						"type": "Expression"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/pg_sql_src_ingest')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/watermark_tbl')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "pg_sql_src_ingest",
					"type": "LinkedServiceReference"
				},
				"folder": {
					"name": "insurance_datasets"
				},
				"annotations": [],
				"type": "PostgreSqlV2Table",
				"schema": [],
				"typeProperties": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/pg_sql_src_ingest')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_az_dl_target_storage')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('ls_az_dl_target_storage_properties_typeProperties_url')]",
					"accountKey": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "ls_az_storage_kv",
							"type": "LinkedServiceReference"
						},
						"secretName": "az-storage-target-secrets-key"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_az_storage_kv')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_az_storage_kv')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureKeyVault",
				"typeProperties": {
					"baseUrl": "[parameters('ls_az_storage_kv_properties_typeProperties_baseUrl')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/pg_sql_src_ingest')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "PostgreSqlV2",
				"typeProperties": {
					"server": "[parameters('pg_sql_src_ingest_properties_typeProperties_server')]",
					"port": "5433",
					"database": "[parameters('pg_sql_src_ingest_properties_typeProperties_database')]",
					"username": "[parameters('pg_sql_src_ingest_properties_typeProperties_username')]",
					"password": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "ls_az_storage_kv",
							"type": "LinkedServiceReference"
						},
						"secretName": "postgres-pwd-locale"
					},
					"sslMode": 2,
					"authenticationType": "Basic"
				},
				"connectVia": {
					"referenceName": "shir-pgsql-local",
					"type": "IntegrationRuntimeReference"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/integrationRuntimes/shir-pgsql-local')]",
				"[concat(variables('factoryId'), '/linkedServices/ls_az_storage_kv')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/shir-pgsql-local')]",
			"type": "Microsoft.DataFactory/factories/integrationRuntimes",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "SelfHosted",
				"typeProperties": {}
			},
			"dependsOn": []
		}
	]
}