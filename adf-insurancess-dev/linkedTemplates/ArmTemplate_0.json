{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-insurancess-dev"
		},
		"ls_az_storage_kv_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://az-insurance-kv.vault.azure.net/"
		},
		"LS_AZ_SQL_FIN_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-insurance-dev.database.windows.net"
		},
		"LS_AZ_SQL_FIN_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "insurance_finanace"
		},
		"LS_AZ_SQL_FIN_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"ls_az_dl_target_storage_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://ssinsurancedev.dfs.core.windows.net/"
		},
		"pg_sql_src_ingest_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"pg_sql_src_ingest_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "postgres"
		},
		"pg_sql_src_ingest_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "postgres"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/ls_az_storage_kv')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureKeyVault",
				"typeProperties": {
					"baseUrl": "[parameters('ls_az_storage_kv_properties_typeProperties_baseUrl')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/shir-pgsql-local')]",
			"type": "Microsoft.DataFactory/factories/integrationRuntimes",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "SelfHosted",
				"typeProperties": {}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_AZ_SQL_FIN')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('LS_AZ_SQL_FIN_properties_typeProperties_server')]",
					"database": "[parameters('LS_AZ_SQL_FIN_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('LS_AZ_SQL_FIN_properties_typeProperties_userName')]",
					"password": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "ls_az_storage_kv",
							"type": "LinkedServiceReference"
						},
						"secretName": "sql-finance-password"
					},
					"connectTimeout": 120
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_az_storage_kv')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_az_dl_target_storage')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('ls_az_dl_target_storage_properties_typeProperties_url')]",
					"accountKey": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "ls_az_storage_kv",
							"type": "LinkedServiceReference"
						},
						"secretName": "az-storage-target-secrets-key"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_az_storage_kv')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pg_sql_src_ingest')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "PostgreSqlV2",
				"typeProperties": {
					"server": "[parameters('pg_sql_src_ingest_properties_typeProperties_server')]",
					"port": "5433",
					"database": "[parameters('pg_sql_src_ingest_properties_typeProperties_database')]",
					"username": "[parameters('pg_sql_src_ingest_properties_typeProperties_username')]",
					"password": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "ls_az_storage_kv",
							"type": "LinkedServiceReference"
						},
						"secretName": "postgres-pwd-locale"
					},
					"sslMode": 2,
					"authenticationType": "Basic"
				},
				"connectVia": {
					"referenceName": "shir-pgsql-local",
					"type": "IntegrationRuntimeReference"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/integrationRuntimes/shir-pgsql-local')]",
				"[concat(variables('factoryId'), '/linkedServices/ls_az_storage_kv')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_ADLS_CONTROL_FILE')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_az_dl_target_storage",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"folderPath": {
						"type": "string"
					},
					"fileName": {
						"type": "string"
					}
				},
				"folder": {
					"name": "partner_settlement_dataset"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().fileName",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@dataset().folderPath",
							"type": "Expression"
						},
						"fileSystem": "settlementstest"
					},
					"columnDelimiter": "|",
					"escapeChar": "\\",
					"firstRowAsHeader": false,
					"quoteChar": ""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_az_dl_target_storage')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_ADLS_CSV')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_az_dl_target_storage",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"folderPath": {
						"type": "string"
					},
					"fileName": {
						"type": "string"
					}
				},
				"folder": {
					"name": "partner_settlement_dataset"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().fileName",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@dataset().folderPath",
							"type": "Expression"
						},
						"fileSystem": "settlementstest"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_az_dl_target_storage')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_ADLS_FILE_BIN')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_az_dl_target_storage",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"folderPath": {
						"type": "string"
					},
					"fileName": {
						"type": "string"
					}
				},
				"folder": {
					"name": "partner_settlement_dataset"
				},
				"annotations": [],
				"type": "Binary",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().fileName",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@dataset().folderPath",
							"type": "Expression"
						},
						"fileSystem": "settlementstest"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_az_dl_target_storage')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_ADLS_FOLDER')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_az_dl_target_storage",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"folderPath": {
						"type": "string"
					}
				},
				"folder": {
					"name": "partner_settlement_dataset"
				},
				"annotations": [],
				"type": "Binary",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"folderPath": {
							"value": "@dataset().folderPath",
							"type": "Expression"
						},
						"fileSystem": "settlementstest"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_az_dl_target_storage')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_AZ_SQL_TBL')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_AZ_SQL_FIN",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"schemaName": {
						"type": "string"
					},
					"tableName": {
						"type": "string"
					}
				},
				"folder": {
					"name": "partner_settlement_dataset"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [],
				"typeProperties": {
					"schema": {
						"value": "@dataset().schemaName",
						"type": "Expression"
					},
					"table": {
						"value": "@dataset().tableName",
						"type": "Expression"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_AZ_SQL_FIN')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/dest_parq_dataset')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_az_dl_target_storage",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"tableName": {
						"type": "string"
					}
				},
				"folder": {
					"name": "insurance_datasets"
				},
				"annotations": [],
				"type": "Parquet",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().tableName",
							"type": "Expression"
						},
						"folderPath": "bronze_test_v2",
						"fileSystem": "destazinsurancedev"
					},
					"compressionCodec": "snappy"
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_az_dl_target_storage')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/onprem_src_pgsql')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "pg_sql_src_ingest",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"table_name": {
						"type": "string"
					}
				},
				"folder": {
					"name": "insurance_datasets"
				},
				"annotations": [],
				"type": "PostgreSqlV2Table",
				"schema": [],
				"typeProperties": {
					"schema": "insurance_oltp",
					"table": {
						"value": "@dataset().table_name",
						"type": "Expression"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/pg_sql_src_ingest')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/watermark_tbl')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "pg_sql_src_ingest",
					"type": "LinkedServiceReference"
				},
				"folder": {
					"name": "insurance_datasets"
				},
				"annotations": [],
				"type": "PostgreSqlV2Table",
				"schema": [],
				"typeProperties": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/pg_sql_src_ingest')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_insurance_claims_cdc')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "lkp_old_watermark",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "PostgreSqlV2Source",
								"query": "SELECT watermark_value from insurance_oltp.watermark_table LIMIT 1;",
								"queryTimeout": "02:00:00"
							},
							"dataset": {
								"referenceName": "watermark_tbl",
								"type": "DatasetReference",
								"parameters": {}
							}
						}
					},
					{
						"name": "lkp_new_watermark",
						"type": "Lookup",
						"dependsOn": [
							{
								"activity": "lkp_old_watermark",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "PostgreSqlV2Source",
								"query": "select max(updated_at) as new_watermark from insurance_oltp.claims;",
								"queryTimeout": "02:00:00"
							},
							"dataset": {
								"referenceName": "watermark_tbl",
								"type": "DatasetReference",
								"parameters": {}
							}
						}
					},
					{
						"name": "if_cdc",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "lkp_new_watermark",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@greater(ticks(activity('lkp_new_watermark').output.firstRow.new_watermark), ticks(activity('lkp_old_watermark').output.firstRow.watermark_value))",
								"type": "Expression"
							},
							"ifFalseActivities": [
								{
									"name": "lkp_log_nochanges",
									"type": "Lookup",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "PostgreSqlV2Source",
											"query": {
												"value": "INSERT INTO insurance_oltp.pipeline_run_log (pipeline_name, run_id, table_name, old_watermark, new_watermark, rows_copied, status) VALUES ('@{pipeline().Pipeline}', '@{pipeline().RunId}', 'claims', '@{activity('lkp_old_watermark').output.firstRow.watermark_value}', '@{activity('lkp_new_watermark').output.firstRow.new_watermark}', 0, 'NO_CHANGES')\n RETURNING log_id;",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00"
										},
										"dataset": {
											"referenceName": "watermark_tbl",
											"type": "DatasetReference",
											"parameters": {}
										}
									}
								}
							],
							"ifTrueActivities": [
								{
									"name": "cp_claims_cdc",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "PostgreSqlV2Source",
											"query": {
												"value": "select * from insurance_oltp.claims\n\nwhere updated_at > '@{activity('lkp_old_watermark').output.firstRow.watermark_value}'\n\nand updated_at <= '@{activity('lkp_new_watermark').output.firstRow.new_watermark}';\n",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00"
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings",
												"copyBehavior": "PreserveHierarchy"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "onprem_src_pgsql",
											"type": "DatasetReference",
											"parameters": {
												"table_name": "claims"
											}
										}
									],
									"outputs": [
										{
											"referenceName": "dest_parq_dataset",
											"type": "DatasetReference",
											"parameters": {
												"tableName": {
													"value": "@concat('claims_incremental/load_',formatDateTime(utcNow(),'yyyyMMddHHmmss'))",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "lkp_update_watermark",
									"type": "Lookup",
									"dependsOn": [
										{
											"activity": "cp_claims_cdc",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "PostgreSqlV2Source",
											"query": {
												"value": "UPDATE insurance_oltp.watermark_table \nSET watermark_value = '@{activity('lkp_new_watermark').output.firstRow.new_watermark}' \nWHERE table_name LIKE '%claims%'\nRETURNING watermark_value;",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00"
										},
										"dataset": {
											"referenceName": "watermark_tbl",
											"type": "DatasetReference",
											"parameters": {}
										}
									}
								},
								{
									"name": "lkp_log_run",
									"type": "Lookup",
									"dependsOn": [
										{
											"activity": "lkp_update_watermark",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "PostgreSqlV2Source",
											"query": {
												"value": "INSERT INTO insurance_oltp.pipeline_run_log (pipeline_name, run_id, table_name, old_watermark, new_watermark, rows_copied, status) VALUES ('@{pipeline().Pipeline}', '@{pipeline().RunId}', 'claims', '@{activity('lkp_old_watermark').output.firstRow.watermark_value}', '@{activity('lkp_new_watermark').output.firstRow.new_watermark}', @{activity('cp_claims_cdc').output.rowsCopied}, 'SUCCESS')\nRETURNING log_id;",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00"
										},
										"dataset": {
											"referenceName": "watermark_tbl",
											"type": "DatasetReference",
											"parameters": {}
										}
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/watermark_tbl')]",
				"[concat(variables('factoryId'), '/datasets/onprem_src_pgsql')]",
				"[concat(variables('factoryId'), '/datasets/dest_parq_dataset')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_settlement_intake')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "until_wait_manifest",
						"type": "Until",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@variables('manifestfound')",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "GM_CHK_MANIFEST",
									"type": "GetMetadata",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"dataset": {
											"referenceName": "DS_ADLS_FILE_BIN",
											"type": "DatasetReference",
											"parameters": {
												"folderPath": {
													"value": "@concat('landing/',formatDateTime(pipeline().parameters.runDate,'yyyy/MM/dd'))",
													"type": "Expression"
												},
												"fileName": {
													"value": "@concat('_MANIFEST_',formatDateTime(pipeline().parameters.runDate,'yyyyMMdd'),'.ctl')",
													"type": "Expression"
												}
											}
										},
										"fieldList": [
											"exists"
										],
										"storeSettings": {
											"type": "AzureBlobFSReadSettings",
											"recursive": true,
											"enablePartitionDiscovery": false
										},
										"formatSettings": {
											"type": "BinaryReadSettings"
										}
									}
								},
								{
									"name": "SV_MANIFEST_FOUND",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "GM_CHK_MANIFEST",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "manifestfound",
										"value": {
											"value": "@activity('GM_CHK_MANIFEST').output.exists",
											"type": "Expression"
										}
									}
								},
								{
									"name": "wait30sec",
									"type": "Wait",
									"dependsOn": [
										{
											"activity": "SV_MANIFEST_FOUND",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"waitTimeInSeconds": {
											"value": "@if(variables('manifestfound'),1,30)",
											"type": "Expression"
										}
									}
								}
							],
							"timeout": "0.12:00:00"
						}
					},
					{
						"name": "GM_LISTFILES",
						"type": "GetMetadata",
						"dependsOn": [
							{
								"activity": "until_wait_manifest",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataset": {
								"referenceName": "DS_ADLS_FOLDER",
								"type": "DatasetReference",
								"parameters": {
									"folderPath": {
										"value": "@concat('landing/',formatDateTime(pipeline().parameters.runDate,'yyyy/MM/dd'))",
										"type": "Expression"
									}
								}
							},
							"fieldList": [
								"childItems"
							],
							"storeSettings": {
								"type": "AzureBlobFSReadSettings",
								"recursive": true,
								"enablePartitionDiscovery": false
							},
							"formatSettings": {
								"type": "BinaryReadSettings"
							}
						}
					},
					{
						"name": "fail_no_partnerfiles",
						"type": "Fail",
						"dependsOn": [
							{
								"activity": "until_wait_manifest",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"message": {
								"value": "@concat('partner files not recieved for', pipeline().parameters.runDate)",
								"type": "Expression"
							},
							"errorCode": "NO_MANIFEST"
						}
					},
					{
						"name": "filter_csvfiles",
						"type": "Filter",
						"dependsOn": [
							{
								"activity": "GM_LISTFILES",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('GM_LISTFILES').output.childItems",
								"type": "Expression"
							},
							"condition": {
								"value": "@endswith(item().name,'.csv' )",
								"type": "Expression"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"runDate": {
						"type": "string",
						"defaultValue": "2026-10-11"
					}
				},
				"variables": {
					"manifestfound": {
						"type": "Boolean"
					},
					"processedfiles": {
						"type": "Array"
					},
					"runsummary": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_FOLDER')]",
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_FILE_BIN')]"
			]
		}
	]
}